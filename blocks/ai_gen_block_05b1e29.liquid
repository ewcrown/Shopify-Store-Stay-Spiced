      "default": 32
    },
    {
      "type": "range",
      "id": "number_size",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Number size",
      "default": 48
    },
    {
      "type": "range",
      "id": "label_size",
