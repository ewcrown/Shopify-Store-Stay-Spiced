      "default": 6
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Weihnachten Blog"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
