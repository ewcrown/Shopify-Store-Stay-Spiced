      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1d1d1d"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Post title color",
      "default": "#1d1d1d"
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Date color",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt color",
