{{ 'testimonial.css' | asset_url | stylesheet_tag }}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css">
<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>

<div
  style="padding: 100px 40px;"
  class="container--large {% unless section.settings.remove_margin %} container--vertical-space {% endunless %} "
>
  {%- render 'section-heading',
    heading: section.settings.title,
    heading_tag: section.settings.seo_h_tag,
    layout: section.settings.section_heading_layout
  -%}

  <div class="testimonial-container {%  if section.settings.trust_element_type == "test--02" %} limit-width {% endif %} {% if section.settings.section_background_color != "rgba(0,0,0,0)" %} container--has-background {% endif %}">
    {%- render 'custom-shadow', section_id: section.id -%}
    {% assign column_count = section.settings.section_content_layout %}

    <div
      class="splide testimonial-splide"
      id="testimonial-splide-{{ section.id }}"
      data-splide='{
        "type": "loop",
        "perPage": {{ column_count }},
        "perMove": 1,
        "gap": "20px",
        "pagination": false,
        "arrows": true,
        "rewind": true,
        "breakpoints": {
          "1024": {
            "perPage": 3,
            "pagination": false,
            "arrows": true
          },
          "768": {
            "perPage": 1,
            "pagination": false,
            "arrows": true
          },
          "480": {
            "perPage": 1,
            "pagination": false,
            "arrows": true
          }
        }
      }'
    >
      <div class="splide__track">
        <div class="splide__list" style="padding-top: 20px; {% if section.settings.trust_element_type == "test--01" %} padding-bottom: 20px; margin-bottom: 20px; {% endif %}">
          {%- for block in section.blocks -%}
            <div
              class="splide__slide slider-item"
              style="{% if section.settings.trust_element_type == "test--01" %} padding: {{ section.settings.padding_value }}px; {% endif %}"
            >
            <div
              class="card__image border-radius-top testimonial-img {% if section.settings.trust_element_type == "test--02" %} testimonial-hidden {% endif %}"
              style="padding-top:{{ 100 | divided_by: 1 }}%;"
            >
              {%- liquid
                unless block.settings.element_img == blank
                  assign sizes = 'sizes="(max-width: 767px) calc(100vw - 20px), (max-width: 1360px) 33vw, 420px"'
                  if section.index == 1 and forloop.index <= 2
                    assign preload = true
                  else
                    assign preload = false
                  endif
                  render 'lazy-image', image: block.settings.element_img, sizes: sizes, ratio: '1', type: 'background', alt: block.settings.title, preload: preload
                else
                  echo 'image' | placeholder_svg_tag
                endunless
              -%}
            </div>
            <div class="reviewer-info {% if section.settings.trust_element_type == "test--02" %} testimonial-hidden {% endif %}">
              {%- unless block.settings.reviewer == blank -%}
                <h5 class="section-heading__title text-align--center h5 element__name">
                  {{ block.settings.reviewer | escape }}
                </h5>
              {% endunless %}
              {%- unless block.settings.content == blank -%}
                <div class="text-align--center">{{ block.settings.content }}</div>
              {% endunless %}
              <div class="star-rating" data-review="{{ block.settings.review }}">
                <div class="stars-outer">
                  <div class="stars-inner stars-inner-{{ block.settings.review | escape }}"></div>
                </div>
              </div>
            </div>
            <div class="{% if section.settings.trust_element_type == "test--01" %} testimonial-hidden {% endif %}">
              <div class="date_author_container">
                {%- unless block.settings.date == blank -%}
                  <span class="text-size--small">
                    {{- block.settings.date | date: '%d-%m-%Y' | escape }}&nbsp;von&nbsp;</span
                  >
                {%- endunless -%}

                {%- unless block.settings.reviewer == blank -%}
                  <span class="text-size--small text-weight--bold" style="font-weight: 900;">
                    {{- block.settings.reviewer | date: '%d-%m-%Y' | escape -}}
                  </span>
                {%- endunless -%}
              </div>
              <div class="star-rating" data-review="{{ block.settings.review }}">
                <div class="stars-outer">
                  <div class="stars-inner stars-inner-{{ block.settings.review | escape }}"></div>
                </div>
              </div>
              {%- unless block.settings.content == blank -%}
                <div class="text-align--center test-02-content text-weight--bold">{{ block.settings.content }}</div>
              {% endunless %}
            </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
  (function() {
    const sectionId = '{{ section.id }}';
    const columnCount = {{ column_count }};
    
    function initTestimonialSlider() {
      const splideElement = document.getElementById('testimonial-splide-' + sectionId);
      if (!splideElement) return;
      
      // Destroy existing instance if any
      if (splideElement.splide) {
        splideElement.splide.destroy();
      }
      
      // Count total slides
      const totalSlides = splideElement.querySelectorAll('.splide__slide').length;
      
      // Initialize Splide - arrows only, no pagination
      const splide = new Splide(splideElement, {
        type: 'loop',
        perPage: columnCount,
        perMove: 1,
        gap: '20px',
        pagination: false, // Disable pagination
        arrows: true, // Enable arrows
        rewind: true,
        updateOnMove: true,
        breakpoints: {
          1024: {
            perPage: 3,
            pagination: false,
            arrows: true
          },
          768: {
            perPage: 1,
            pagination: false,
            arrows: true
          },
          480: {
            perPage: 1,
            pagination: false,
            arrows: true
          }
        }
      });
      
      splide.mount();
      
    }
    
    function initStarRatings() {
      const ratings = document.querySelectorAll('#testimonial-splide-' + sectionId + ' .star-rating');

      ratings.forEach((rating) => {
        const value = parseFloat(rating.getAttribute('data-review'));
        setRating(rating, value);
      });

      function setRating(element, value) {
        const starTotal = 5;
        const starPercentage = (value / starTotal) * 100;
        const selector = `.stars-inner-${value}::before`;
        
        // Check if rule already exists
        let ruleExists = false;
        try {
          for (let i = 0; i < document.styleSheets.length; i++) {
            const sheet = document.styleSheets[i];
            try {
              const rules = sheet.cssRules || sheet.rules;
              for (let j = 0; j < rules.length; j++) {
                if (rules[j].selectorText === selector) {
                  ruleExists = true;
                  break;
                }
              }
            } catch (e) {
              // Cross-origin stylesheet, skip
            }
            if (ruleExists) break;
          }
        } catch (e) {}
        
        if (!ruleExists) {
          try {
            const sheet = document.styleSheets[0];
            sheet.insertRule(`${selector} { width: ${starPercentage}%; }`, sheet.cssRules.length);
          } catch (e) {
            const style = document.createElement('style');
            style.textContent = `${selector} { width: ${starPercentage}%; }`;
            document.head.appendChild(style);
          }
        }
      }
    }
    
    // Initialize on DOM ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initTestimonialSlider();
        initStarRatings();
      });
    } else {
      initTestimonialSlider();
      initStarRatings();
    }
    
    // Reinitialize on Shopify section load (theme editor)
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === sectionId) {
        setTimeout(function() {
          initTestimonialSlider();
          initStarRatings();
        }, 100);
      }
    });
  })();
</script>

<style>
  /* Splide customization for testimonial slider */
  #testimonial-splide-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }
  
  #testimonial-splide-{{ section.id }} .splide__track {
    overflow: visible;
  }
  
  /* Hide pagination completely */
  #testimonial-splide-{{ section.id }} .splide__pagination {
    display: none !important;
  }
  
  #testimonial-splide-{{ section.id }} .splide__list {
    display: flex;
    margin: 0;
  }
  
  #testimonial-splide-{{ section.id }} .splide__slide {
    width: 100%;
    flex-shrink: 0;
  }
  
  #testimonial-splide-{{ section.id }} {
    position: relative;
    padding-bottom: 50px;
  }
  
  /* Hide pagination */
  #testimonial-splide-{{ section.id }} .splide__pagination {
    display: none !important;
  }
  
  /* Style arrows - centered at bottom */
  #testimonial-splide-{{ section.id }} .splide__arrows {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 20px;
    z-index: 10;
  }
  
  #testimonial-splide-{{ section.id }} .splide__arrow {
    position: static !important;
    background: transparent;
    opacity: 0.6;
    width: auto;
    height: auto;
    transform: none !important;
    pointer-events: all;
    cursor: pointer;
    transition: opacity 0.3s ease;
    border: none;
    padding: 0;
    margin: 0;
  }
  
  #testimonial-splide-{{ section.id }} .splide__arrow:hover {
    opacity: 1;
  }
  
  #testimonial-splide-{{ section.id }} .splide__arrow svg {
    fill: #666;
    width: 16px;
    height: 16px;
  }
  
  #testimonial-splide-{{ section.id }} .splide__arrow--prev {
    left: auto;
  }
  
  #testimonial-splide-{{ section.id }} .splide__arrow--next {
    right: auto;
  }
  
  /* Ensure no white space */
  .testimonial-container {
    width: 100%;
    overflow: visible;
    position: relative;
    padding-bottom: 50px;
  }
  
  .testimonial-container .splide {
    width: 100%;
    position: relative;
  }

  @media (max-width: 768px) {
    #testimonial-splide-{{ section.id }} {
      padding-bottom: 100px !important;
    }
    #testimonial-splide-{{ section.id }} .splide__slide {
      padding: 0 !important;
    }
    #testimonial-splide-{{ section.id }} .splide__arrows {
      bottom: 0px !important;
    } 
  }
</style>

{%- if section.settings.section_background_color != 'rgba(0,0,0,0)'
  and section.settings.trust_element_type == 'test--01'
-%}
  {% style %}
    #shopify-section-{{ section.id }} .container--has-background {
      --color-background-section: {{ section.settings.section_background_color }};
    }
  {% endstyle %}
{%- elsif section.settings.section_background_color != 'rgba(0,0,0,0)'
  and section.settings.trust_element_type == 'test--02'
-%}
  {% style %}
    #shopify-section-{{ section.id }} .container--has-background {
      background-color: {{ section.settings.section_background_color }};
      padding-top: 20px !important;
      padding-bottom: 20px !important;
    }
  {% endstyle %}
{%- endif -%}

{%- if section.settings.section_heading_color != 'rgba(0,0,0,0)' -%}
  {% style %}
    #shopify-section-{{ section.id }}, .element__name {
      --color-text-main: {{ section.settings.section_heading_color }};
    }
  {% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "Testimonial Element",
  "blocks": [
    {
      "type": "element",
      "name": "element block",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "element_img",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "reviewer",
          "label": "Reviewr"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "range",
          "id": "review",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 0.1,
          "default": 5
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:local-march-update.labels.heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.blog-posts.settings.title.label",
      "default": "Testimonial"
    },
    {
      "type": "select",
      "id": "trust_element_type",
      "label": "Testimonial Element Type",
      "options": [
        {
          "value": "test--01",
          "label": "Testimonial 01"
        },
        {
          "value": "test--02",
          "label": "Testimonial 02"
        }
      ],
      "default": "test--01"
    },
    {
      "type": "range",
      "id": "padding_value",
      "label": "Padding Value",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "section_heading_layout",
      "label": "t:sections.rich-text.settings.text_alignment.label",
      "options": [
        {
          "value": "section-heading--left",
          "label": "t:sections.rich-text.settings.text_alignment.options__1.label"
        },
        {
          "value": "section-heading--center",
          "label": "t:sections.rich-text.settings.text_alignment.options__2.label"
        }
      ],
      "default": "section-heading--left"
    },
    {
      "type": "range",
      "id": "section_content_layout",
      "label": "column count",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:local-march-update.labels.section_design"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "t:sections.local-extra-words.settings_schema.product-card.badges.custom_badges.color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "section_heading_color",
      "label": "t:sections.local-extra-words.settings_schema.product-card.badges.custom_badges.text_color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "checkbox",
      "id": "remove_margin",
      "label": "t:sections.local-extra-words.sections.rich-text.settings.remove_margin.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.refactor_words.seo.name"
    },
    {
      "type": "select",
      "id": "seo_h_tag",
      "label": "t:sections.refactor_words.seo.label",
      "info": "t:sections.refactor_words.seo.info",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "span",
          "label": "span"
        }
      ],
      "default": "h2"
    }
  ],
  "presets": [
    {
      "name": "Testimonial-Element",
      "blocks": [{ "type": "element" }]
    }
  ]
}
{% endschema %}
