          "value": "full",
          "label": "t:sections.local-extra-words.sections.media-with-text-overlay.settings.option__4"
        }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "t:sections.local-extra-words.sections.headings.text_style"
    },
    {
      "type": "select",
      "id": "alignment",
