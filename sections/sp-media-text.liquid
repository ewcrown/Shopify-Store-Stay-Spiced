{% assign text_snippet_id = section.settings.text_snippet | append: '_text_block' %}
{% assign text_snippet = metaobject[text_snippet_id].value %}
{% assign image = text_snippet.featured_image.value | image_url %}
{% assign video = text_snippet.featured_video.value %}

{% if text_snippet %}
  <div
    id="section-{{ section.id }}"
    class="container--fullwidth {% unless section.settings.remove_margin %} container--vertical-space {% endunless %} {% if section.settings.section_background_color != "rgba(0,0,0,0)" %} container--has-background {% endif %} remove-empty-space"
  >
    <div class="grid grid--layout grid-1">
      <div
        class="card element--height-{{ section.settings.height }} align-content align-content--{{ section.settings.alignment }} card--no-radius"
        {{ section.shopify_attributes }}
      >
        {% comment %}
          {%- if block.settings.link != blank
            and block.settings.button_label == blank
            and block.settings.title == blank
            and block.settings.subtitle == blank
          -%}
            <a
              href="{{ block.settings.link }}"
              class="card__whole-link"
              aria-hidden="true"
              {% if block.settings.open_in_new_window %}
                target="_blank"
              {% endif %}
            ></a>
          {%- endif -%}
        {% endcomment %}

        <div class="card__text gutter--large spacing--large remove-empty-space" id="element-{{ section.id }}">
          {%- unless text_snippet.title == blank -%}
            <{{ section.settings.seo_h_tag }} class="{{ section.settings.title_size }}">
              {%- if text_snippet.button_label == blank and text_snippet.button_link != blank -%}
                <a
                  href="{{ text_snippet.button_link | escape }}"
                  target="_blank"
                >
              {%- endif -%}

              <span class="text-animation--underline underline-mobile">
                {{- text_snippet.title | escape -}}
              </span>

              {%- if text_snippet.button_label == blank and text_snippet.button_link != blank -%}
                </a>
              {%- endif -%}
            </{{ section.settings.seo_h_tag }}>
          {%- endunless -%}

          {%- if text_snippet.button_label != blank -%}
            <div class="increased-spacing">
              <a
                href="{{ text_snippet.button_link | escape }}"
                class="button button--{{ section.settings.button_size }} button--{{ section.settings.button_style }} button--squared"
                style="color: black; background-color: white"
              >
                {{- text_snippet.button_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        </div>

        <div
          class="card__image card__image--background {% if text_snippet.background_color != "rgba(0,0,0,0)" %} card__image--with-overlay {% endif %}"
          aria-hidden="true"
        >
          {%- liquid
            assign video_url = text_snippet.featured_video
            for source in text_snippet.featured_video.sources
              unless source.url contains 'm3u8'
                assign video_url = source.url
              endunless
            endfor
          -%}

          {%- unless video_url != blank -%}
            {%- liquid
              unless text_snippet.featured_image == blank
                assign sizes = 'sizes="(max-width: 1360px) calc(100vw - 20px), 1280px"'
                if section.index == 1 and forloop.index <= 2
                  assign preload = true
                else
                  assign preload = false
                endif
                render 'lazy-image', image: image, sizes: sizes, type: 'background', alt: text_snippet.title, image_alignment: true, id: section.id, preload: preload
              else
                echo 'image' | placeholder_svg_tag
              endunless
            -%}

          {%- else -%}
            {{ 'component-video-background.css' | asset_url | stylesheet_tag }}

            <div id="video-background-{{ section.id }}" class="video-background" style="display:block">
              <div class="video-text__container">
                <video-background-element class="video-text__background" data-id="{{ section.id }}">
                  <video autoplay muted loop playsinline>
                    {%- for source in video.sources -%}
                      <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endfor -%}
                  </video>
                </video-background-element>

                {%- unless text_snippet.featured_image == blank -%}
                  <div data-video-background-fallback data-id="{{ section.id }}">
                    <template>
                      <span class="video-text__image" aria-hidden="true">
                        {%- liquid
                          assign sizes = 'sizes="(max-width: 1023px) calc(100vw - 60px), 84vw"'
                          render 'lazy-image', image: image, type: 'background', sizes: sizes, id: section.id
                        -%}
                      </span>
                    </template>
                  </div>
                {%- endunless -%}
              </div>
            </div>

            <script src="{{ 'component-video-background.js' | asset_url }}" defer></script>
          {%- endunless -%}
        </div>
      </div>
    </div>
  </div>

  {% style %}
    @media screen and (min-width: 640px) {
      #shopisection-{{ section.id }} .card__text {
        max-width: {{ section.settings.width }};
      }
    }
  {% endstyle %}

  {%- if text_snippet.background_color.value.color -%}
    {% style %}
      #shopify-section-{{ section.id }} .container--has-background {
        --color-background-section: {{ text_snippet.background_color.value.color }};
      }
    {% endstyle %}
  {%- elsif metaobject.background_color.value.color -%}
    {% style %}
      .main-content {
              background-color: {{ metaobject.background_color.value.color }};
            }
    {% endstyle %}
  {%- endif -%}

  {%- if text_snippet.text_color.value.color -%}
    {% style %}
      #element-{{ section.id }} {
        color: {{ text_snippet.text_color.value.color }};
      }
    {% endstyle %}
  {%- endif -%}
{% endif %}

{% schema %}
{
