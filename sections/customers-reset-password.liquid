{{ 'section-account.css' | asset_url | stylesheet_tag }}

<div class="container--large container--vertical-space" id="section-reset-password">
  <h1 class="h2">{{ 'customers.password_reset_page.title' | t }}</h1>

  <div class="account gutter-top--regular">
    {%- form 'reset_customer_password', class: 'account__form-block' -%}
      <span class="alert alert--note">
        {{ 'customers.password_reset_page.subtitle' | t: email: email }}
      </span>

      {%- render 'form-errors', form: form -%}

      <div class="account__form-row">
        <label for="ResetPassword" class="text-size--small">
          {{- 'customers.password_reset_page.password_label' | t -}}
        </label>
        <div style="position: relative;">
          <input
            type="password"
            value=""
            name="customer[password]"
            id="ResetPassword"
            class="input-full{% if form.errors contains 'password' %} error{% endif %}"
          >
          <span
            class="password-toggle-icon"
            style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer;"
          >
            <i id="togglePasswordIcon" class="fas fa-eye"></i>
          </span>
        </div>
      </div>

      <div class="account__form-row">
        <label for="PasswordConfirmation" class="text-size--small">
          {{- 'customers.password_reset_page.password_confirm_label' | t -}}
        </label>
        <div style="position: relative;">
          <input
            type="password"
            value=""
            name="customer[password_confirmation]"
            id="PasswordConfirmation"
            class="input-full{% if form.errors contains 'password_confirmation' %} error{% endif %}"
          >
          <span
            class="password-toggle-icon"
            style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer;"
          >
            <i id="togglePasswordConfirmIcon" class="fas fa-eye"></i>
          </span>
        </div>
      </div>

      <div class="account__form-row gutter-top--small">
        <input
          type="submit"
          class="button button--solid button--regular"
          value="{{ 'customers.password_reset_page.submit' | t }}"
        >
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.local-extra-words.sections.customers.reset-password.name",
  "class": "section--remove-bottom-margin-after"
}
{% endschema %}

<script>
  const passwordInput = document.getElementById('ResetPassword');
  const togglePasswordIcon = document.getElementById('togglePasswordIcon');

  togglePasswordIcon.addEventListener('click', function () {
    // Toggle the password visibility
    const isPassword = passwordInput.type === 'password';
    passwordInput.type = isPassword ? 'text' : 'password';

    // Toggle the icon class
    togglePasswordIcon.classList.toggle('fa-eye');
    togglePasswordIcon.classList.toggle('fa-eye-slash');
  });

  const passwordConfirmInput = document.getElementById('PasswordConfirmation');
  const togglePasswordConfirmIcon = document.getElementById('togglePasswordConfirmIcon');

  togglePasswordConfirmIcon.addEventListener('click', function () {
    // Toggle the password visibility
    const isPassword = passwordConfirmInput.type === 'password';
    passwordConfirmInput.type = isPassword ? 'text' : 'password';

    // Toggle the icon class
    togglePasswordConfirmIcon.classList.toggle('fa-eye');
    togglePasswordConfirmIcon.classList.toggle('fa-eye-slash');
  });
</script>
