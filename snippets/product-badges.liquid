<div class="product-item__badges {{ text_class }}">
  {%- if product.available == false -%}
    <span
      class="product-item__badge product-item__badge--sold sold-out"
      style="background-color: {{ settings.product_card_badge_sold_out_color }}; color: {{ settings.product_card_badge_sold_out_text_color }}"
    >
      {{ 'products.grid.sold_out_product' | t }}
    </span>
  {%- endif -%}

  {%- comment -%}
    Determine if there is any real discount (compare_at_price > price and compare_at_price > 0).
    For products with variants we search variants; otherwise use product-level values.
  {%- endcomment -%}

  {%- liquid
    assign has_sale = false
    assign compare_price_nums = 0
    assign max_compare_at_price = 0
    assign compare_at_price = 0
    assign price = 0

    if product.variants.size > 1
      for variant in product.variants
        if variant.compare_at_price and variant.compare_at_price > variant.price and variant.compare_at_price > 0
          assign has_sale = true
          assign compare_price_nums = compare_price_nums | plus: 1
          assign variant_saving = variant.compare_at_price | minus: variant.price
          if variant_saving > max_compare_at_price
            assign max_compare_at_price = variant_saving
            assign compare_at_price = variant.compare_at_price
            assign price = variant.price
          endif
        endif
      endfor
    else
      if product.compare_at_price and product.compare_at_price > product.price and product.compare_at_price > 0
        assign has_sale = true
        assign compare_price_nums = 1
        assign compare_at_price = product.compare_at_price
        assign price = product.price
      endif
    endif
  -%}

  {%- if has_sale -%}
    <span class="product-item__badge product-item__badge--sale">
      {%- liquid
        if settings.product_card_badge_sale_type == 'percentage'
          if compare_at_price and compare_at_price > 0
            assign saved_numerator = compare_at_price | minus: price
            assign saved_percent = saved_numerator | times: 100 | divided_by: compare_at_price | round
            assign saved = saved_percent | append: '%'

            if compare_price_nums == 1
              echo saved
            else
              echo 'products.grid.save_percent' | t: percent: saved
            endif
          else
            echo 'products.grid.on_sale_product' | t
          endif

        elsif settings.product_card_badge_sale_type == 'amount'
          if compare_at_price and compare_at_price > price
            assign saved_amount = compare_at_price | minus: price | money

            if compare_price_nums == 1
              echo 'products.grid.save_amount_html' | t: amount: saved_amount
            else
              echo 'products.grid.save_up_to_amount_html' | t: amount: saved_amount
            endif
          else
            echo 'products.grid.on_sale_product' | t
          endif

        else
          echo 'products.grid.on_sale_product' | t
        endif
      -%}
    </span>
  {%- endif -%}

  {%- if settings.product_card_badge_custom_1_tags != blank
    and product.tags contains settings.product_card_badge_custom_1_tags
  -%}
    <span
      class="product-item__badge product-item__badge--{{ settings.product_card_badge_custom_1_text | handleize }}"
      style="background-color: {{ settings.product_card_badge_custom_1_color }}; color: {{ settings.product_card_badge_custom_1_text_color }}"
    >
      {{ settings.product_card_badge_custom_1_text }}
    </span>
  {%- endif -%}

  {%- if settings.product_card_badge_custom_2_tags != blank
    and product.tags contains settings.product_card_badge_custom_2_tags
  -%}
    <span
      class="product-item__badge product-item__badge--{{ settings.product_card_badge_custom_2_text | handleize }}"
      style="background-color: {{ settings.product_card_badge_custom_2_color }}; color: {{ settings.product_card_badge_custom_2_text_color }}"
    >
      {{ settings.product_card_badge_custom_2_text }}
    </span>
  {%- endif -%}

  {%- if settings.product_card_badge_custom_3_tags != blank
    and product.tags contains settings.product_card_badge_custom_3_tags
  -%}
    <span
      class="product-item__badge product-item__badge--{{ settings.product_card_badge_custom_3_text | handleize }}"
      style="background-color: {{ settings.product_card_badge_custom_3_color }}; color: {{ settings.product_card_badge_custom_3_text_color }}"
    >
      {{ settings.product_card_badge_custom_3_text }}
    </span>
  {%- endif -%}

  {% if product.metafields.custom.labels %}
    {% for label in product.metafields.custom.labels.value %}
      <span
        class="product-item__badge product-item__badge--round product-item__badge--custom"
        style="--badge-background-color: {{label.color.value.color}}; --badge-color: {{ label.color.value.secondary }}"
      >
        {{ label.title | metafield_text -}}
      </span>
    {% endfor %}
  {% endif %}
</div>