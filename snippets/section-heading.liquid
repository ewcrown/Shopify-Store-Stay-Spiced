{%- unless heading == blank and subheading == blank and button == blank -%}
  <div class="section-heading {{ layout }} {{specialClass}} gutter-bottom--page">
    {%- unless heading == blank and subheading == blank -%}
      <div class="section-heading__text remove-empty-space" style="max-width: {{max_width}}px;">
        {%- unless heading == blank -%}
          <{{ heading_tag }} class="section-heading__title {% if headingSize != blank %} {{headingSize}} {% else %} h4 {% endif %}">
            {{- heading | escape -}}
          </{{ heading_tag }}>
        {%- endunless -%}

        {%- unless subheading == blank -%}
          <span class="section-heading__subheading text-size--large">{{ subheading }}</span>
        {%- endunless -%}
      </div>
    {%- endunless -%}

    {%- unless button == blank or layout contains 'center' -%}
      <div class="section-heading__actions">
        {%- if button -%}
          <a class="text-size--large text-link" href="{{ link }}">{{ button_label }}</a>
        {%- endif -%}
      </div>
    {%- endunless -%}
  </div>
{%- endunless -%}
