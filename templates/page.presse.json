          "settings": {
            "title": "Alle Infos im Überblick",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<ul><li><strong>Gründung des Unternehmens:</strong> 2005 als SPICEWORLD GmbH</li><li><strong>Launch der Marke:</strong> 2019</li><li><strong>Standorte:</strong> Salzburg & Oberösterreich</li><li><strong>Produktion:</strong> alles Inhouse – keine externe Abfüllung</li><li><strong>Sortiment:</strong> über 160 Reingewürze & 365 Mischungen</li><li><strong>Vertrieb:</strong> Online, stationär & im Handel</li><li><strong>Kooperationen: </strong>Mit Spitzenköchen, Restaurants & Marken</li><li><strong>USP: </strong>100 % Qualität, nachhaltige Herkunft, mutiges Design<br/></li></ul>",
            "hide_block_if": false
          }
        }
      },
