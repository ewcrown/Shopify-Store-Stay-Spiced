    "content_toggles_XThwef": {
      "type": "content-toggles",
      "blocks": {
        "text_Rc8TWJ": {
          "type": "text",
          "settings": {
            "title": "Welche Themen können Journalist:innen über STAY SPICED ! behandeln?  ",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>STAY SPICED ! bietet eine breite Vielfalt an Themen für deine journalistische Arbeit – unter anderem:</p><ul><li>Die Bedeutung von Premium-Gewürzen in der modernen Küche</li><li>Nachhaltigkeit im Gewürzhandel</li><li>Tipps & Tricks für das perfekte Würzen</li><li>Innovative Produktentwicklungen & saisonale Trends</li><li>Rezepte und Anwendungsideen</li><li>Behind the Scenes: Einblick in unsere Produktion</li><li>Regionalität & Eigenanbau<br/></li></ul>",
            "hide_block_if": false
          }
        }
      },
      "block_order": [
        "text_Rc8TWJ"
      ],
