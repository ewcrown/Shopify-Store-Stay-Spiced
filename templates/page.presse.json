    "content_toggles_RCeiPE": {
      "type": "content-toggles",
      "blocks": {
        "text_ce6qnA": {
          "type": "text",
          "settings": {
            "title": "Dein direkter Kontakt",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p><strong>PR & Kommunikationsagentur danberg&danberg</strong><br/>presse@danberg-danberg.com<br/>+43 2231 21647<br/></p>",
            "hide_block_if": false
          }
        },
        "text_GbXibh": {
          "type": "text",
          "settings": {
            "title": "Presse-Events & Produktions-Einblicke",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Aus Gründen der Lebensmittelsicherheit können wir leider keine persönlichen Einblicke in unsere Produktion ermöglichen.<br/>Damit du dir dennoch ein gutes Bild machen kannst, stellen wir dir gerne hochwertiges Bildmaterial zur Verfügung – von unserer Manufaktur bis hin zu Produkten, Team & Stimmung.</p><p><strong>presse@danberg-danberg.com</strong><br/></p>",
            "hide_block_if": false
          }
        },
        "text_zdpUfM": {
          "type": "text",
          "settings": {
            "title": "Du möchtest künftig über STAY SPICED ! informiert bleiben oder bei zukünftigen Events dabei sein?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Dann melde dich gerne für unseren Presseverteiler an – ebenfalls via<br/><strong>presse@danberg-danberg.com</strong><br/></p>",
            "hide_block_if": false
          }
        }
      },
