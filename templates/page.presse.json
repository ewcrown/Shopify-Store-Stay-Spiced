    "content_toggles_aUa8Vm": {
      "type": "content-toggles",
      "blocks": {
        "text_4LTxUG": {
          "type": "text",
          "settings": {
            "title": "Wer ist STAY SPICED ! ?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p><strong>STAY SPICED !</strong> ist die Premium-Gewürzmarke der <strong>SPICEWORLD GmbH</strong>, die 2005 in einer Garage in Salzburg gegründet wurde. Was als mutige Idee begann, ist heute ein erfolgreiches Unternehmen – bekannt für kompromisslose Qualität, Innovation und echtes Geschmackserlebnis.</p><p>Die Marke <strong>STAY SPICED !</strong> wurde 2019 gelauncht und steht für moderne Gewürzkultur, mutiges Design und ein Sortiment, das Profiköch:innen ebenso begeistert wie ambitionierte Hobbyköch:innen. Die über 400 Reingewürze und Mischungen sind zu 100 % natürlich, nahezu vollständig vegan und voller Leidenschaft entwickelt – für alle, die das Kochen als Genuss feiern.</p>",
            "hide_block_if": false
          }
        },
        "text_qf4DdY": {
          "type": "text",
          "settings": {
            "title": "Wo hat STAY SPICED ! seinen Sitz?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Unser Hauptsitz befindet sich in Salzburg, Österreich – unsere Gewürzmanufaktur im angrenzenden Oberösterreich.</p>",
            "hide_block_if": false
          }
        },
        "text_BHz9xU": {
          "type": "text",
          "settings": {
            "title": "Seit wann gibt es STAY SPICED ! ?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Die <strong>SPICEWORLD GmbH</strong> wurde 2005 in einer Garage in Salzburg gegründet – mit der Vision, den Gewürzmarkt durch kompromisslose Qualität und Leidenschaft neu zu definieren.</p><p>Im Jahr 2019 wurde die<strong> Marke STAY SPICED !</strong> offiziell gelauncht. Seither steht sie für moderne Gewürzkultur, innovative Produktentwicklung und echtes Geschmackserlebnis.</p><p>Heute ist STAY SPICED ! national wie international als Qualitätsführer im Premium-Gewürzsegment etabliert – mit Wurzeln in Österreich und einer wachsenden Community an Genussmenschen weit über die Landesgrenzen hinaus.<br/></p>",
            "hide_block_if": false
          }
        },
        "text_wXXxYj": {
          "type": "text",
          "settings": {
            "title": "Was zeichnet die Produkte von STAY SPICED ! aus?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Unsere Gewürze sind zu 100 % natürlich, ohne Zusatzstoffe, vorwiegend vegan, und werden mit größter Sorgfalt in unserer hauseigenen Produktion entwickelt und abgefüllt.</p>",
            "hide_block_if": false
          }
        }
      },
      "block_order": [
