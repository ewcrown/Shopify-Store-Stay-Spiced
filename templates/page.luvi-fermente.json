        },
        "text_BD3Ryr": {
          "type": "text",
          "settings": {
            "title": "Nachhaltiges Wirtschaften und Handeln",
            "caption": "<p>Bei der Verarbeitung von Fisch ist LUVI Fermente die Verwertung des ganzen Tieres wichtig. Für die Fischsauce werden keine Fische gefangen – fermentiert werden frische Abschnitte aus der umliegenden Gastronomie. Die alten Römer nannten diese Sauce Garum bzw. Liquamen – einst so allgegenwärtig wie heute das Salz am Esstisch.</p>",
            "seo_h_tag": "h3"
          }
        },
        "text_JRbwAE": {
          "type": "text",
          "settings": {
            "title": "Wir forschen nach neuen Geschmäckern",
            "caption": "<p>Wir verarbeiten regionale und anfallende Lebensmittel und veredeln diese mithilfe ausgewählter Mikroorganismen zu Saucen, Misopasten und anderen Fermenten.</p>",
