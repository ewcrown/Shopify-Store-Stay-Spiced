        "text_TJBqxh": {
          "type": "text",
          "settings": {
            "text": "<p>„Für uns endet die Qualität nicht bei den Gewürzen. Wir garantieren dir höchste Standards in allem, was wir tun – von der Auswahl der Rohstoffe über die Verarbeitung bis hin zu unserem Verpackungsdesign.“<br/><br/>Unsere Gewürze kommen nicht nur aus den besten Anbauregionen, sondern werden auch mit höchster Sorgfalt verpackt. Unsere Gewürzdosen sind nicht nur funktional, sondern auch ein wahrer Hingucker – gefertigt in Österreich aus 100% recycelbarem Weißblech, und aus nachhaltigen Materialien, die Mutter Erde gut tun. Zudem haben wir den CO2-neutralen Versand implementiert, um auch hier einen Beitrag zum Umweltschutz zu leisten.<br/></p>",
            "content_source": "custom",
            "text_size": "regular"
          }
        }
