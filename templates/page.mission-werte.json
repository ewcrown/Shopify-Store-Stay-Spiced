        "text_zDKpxc": {
          "type": "text",
          "settings": {
            "text": "<p>S! steht für Qualität ohne Kompromisse – in jedem Detail. Unsere Werte sind das Fundament, auf dem wir jedes Gewürz und jede Mischung aufbauen. Sie prägen unser Handeln und unsere Philosophie. Wir stellen sicher, dass jedes Gewürz nicht nur ein Hochgenuss für deine Sinne, sondern auch nachhaltig und mit größtem Respekt vor der Natur hergestellt wird.<br/></p>",
            "content_source": "custom",
            "text_size": "regular"
