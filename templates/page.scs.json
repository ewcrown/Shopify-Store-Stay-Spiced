    "rich_text_9p987a": {
      "type": "rich-text",
      "blocks": {
        "title_L7tzTq": {
          "type": "title",
          "settings": {
            "title": "Welche Gewürze braucht man?",
            "title_size": "h3",
            "seo_h_tag": "h2"
          }
        },
        "subtitle_Nqn3tt": {
          "type": "subtitle",
          "settings": {
            "subtitle": "Bei uns findest du eine vielfältige Auswahl an Gewürzen und Gewürzmischungen, die dein tägliches Kochen zum Kinderspiel machen. ",
            "title_size": "h2"
          }
        },
        "text_yqGahF": {
          "type": "text",
          "settings": {
            "text": "<p><br/>Von <em><strong>Grillgewürzen </strong></em>über Backgewürze, von Barbecue-Gewürzen bis hin zu Curry-Gewürzen – wir haben alles für dich zusammengefasst. Unsere mediterranen Gewürze, indischen Gewürze, <em><strong>Gewürze für Fisch</strong></em>, Gemüse und Fleisch sowie<em><strong> salzfreie Gewürzmischungen</strong></em> bieten dir grenzenlose Inspiration und <em><strong>köstliche Rezepte</strong></em>. <br/><br/></p><p>Vertraue dabei auf die Empfehlungen unserer Testimonials wie <em><strong>Roland Trettl</strong></em>, <em><strong>Haya Molcho, Tom Heinzle</strong></em> und <em><strong>Ben Perry</strong></em> sowie auf die leidenschaftliche Community.</p>",
            "content_source": "custom",
            "text_size": "regular"
          }
        },
        "button_76tdEK": {
          "type": "button",
          "settings": {
            "button_label": "Entdecke alle Gewürze",
