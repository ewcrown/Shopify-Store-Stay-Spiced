    "rich_text_zz8eNQ": {
      "type": "rich-text",
      "blocks": {
        "title_LaUzdC": {
          "type": "title",
          "settings": {
            "title": "Außergewöhnliche Geschenke",
            "title_size": "h3",
            "seo_h_tag": "h2"
          }
        },
        "text_eRNgA4": {
          "type": "text",
          "settings": {
            "text": "<p><br/>Verschenke einzigartigen Genuss mit unseren exquisiten <em><strong>Gewürzen</strong></em>! Unsere hochwertigen Gewürzmischungen sind das perfekte Geschenk für alle Feinschmecker - das ganze Jahr über. <br/><br/></p><p>Stelle aus unserer Vielfalt eine <em><strong>Geschenkbox </strong></em>zusammen, die genau auf den Geschmack des Beschenkten abgestimmt ist. Egal ob für besondere Anlässe oder als kleine Überraschung - unsere attraktiven Banderolen und variierenden Boxengrößen machen jedes Geschenk zu einem echten Hingucker. <br/></p><p><br/>Du bist noch unentschlossen? Mit unseren <em><strong>Gutscheinen </strong></em>schenkst du Freude und Flexibilität zugleich. </p>",
            "content_source": "custom",
            "text_size": "regular"
          }
        },
        "button_6TYHLM": {
          "type": "button",
          "settings": {
            "button_label": "Jetzt Geschenke entdecken",
            "link": "shopify://collections/alle-geschenke",
