    "rich_text_LjLARD": {
      "type": "rich-text",
      "blocks": {
        "title_dypBCy": {
          "type": "title",
          "settings": {
            "title": "Welche Gewürze braucht man?",
            "title_size": "h3",
            "seo_h_tag": "h2"
          }
        },
        "subtitle_tVrW6e": {
          "type": "subtitle",
          "settings": {
            "subtitle": "Entdecke die perfekte Gewürzmischung für unvergleichliche Geschmackserlebnisse!",
            "title_size": "h2"
          }
        },
        "text_cGaMHM": {
          "type": "text",
          "settings": {
            "text": "<p><br/>Von <a href=\"/collections/grillen\" title=\"Grillen\"><em><strong>Grillgewürzen </strong></em></a>über Backgewürze, von Barbecue-Gewürzen bis hin zu Curry-Gewürzen – wir haben alles für dich zusammengefasst. Unsere <a href=\"/collections/mediterran\" title=\"Mediterran\">mediterranen Gewürze</a>, indischen Gewürze, <a href=\"/collections/fisch\" title=\"Fisch\"><em><strong>Gewürze für Fisch</strong></em>,</a> Gemüse und Fleisch sowie<em><strong> </strong></em><a href=\"/collections/free\" title=\"FREE - Gewürze ohne\"><em><strong>salzfreie Gewürzmischungen</strong></em></a> bieten dir grenzenlose Inspiration und <a href=\"/pages/alle-rezepte\" title=\"Alle Rezepte\"><em><strong>köstliche Rezepte</strong></em>.</a> <br/><br/></p><p>Vertraue dabei auf die Empfehlungen unserer Testimonials wie <a href=\"/collections/roland-trettl\" title=\"Roland Trettl\"><em><strong>Roland Trettl</strong></em></a>, <a href=\"/collections/haya-molcho-neni\" title=\"Haya Molcho - NENI\"><em><strong>Haya Molcho</strong></em></a>,<em><strong> </strong></em><a href=\"/collections/tom-heinzle\" title=\"Tom Heinzle\"><em><strong>Tom Heinzle</strong></em></a> und <a href=\"/collections/ben-perry\" title=\"Ben Perry\"><em><strong>Ben Perry</strong></em></a> sowie auf die leidenschaftliche Community.</p>",
            "content_source": "custom",
            "text_size": "regular"
          }
        },
        "button_UbXT4X": {
          "type": "button",
          "settings": {
            "button_label": "Entdecke hier alle Gewürze",
            "link": "shopify://collections/gewurz",
            "target_id": "",
            "open_in_new_window": false,
            "button_size": "regular",
            "button_style": "solid"
          }
        }
      },
      "block_order": [
        "title_dypBCy",
