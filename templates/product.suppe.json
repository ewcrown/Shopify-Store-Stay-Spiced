    "rich_text_9nh9qk": {
      "type": "rich-text",
      "blocks": {
        "title_iHgacR": {
          "type": "title",
          "settings": {
            "title": "Außergewöhnliche Geschenke",
            "title_size": "h3",
            "seo_h_tag": "h3"
          }
        },
        "subtitle_nXD67p": {
          "type": "subtitle",
          "settings": {
            "subtitle": "Gewürze mag Jede/r!",
            "title_size": "h2"
          }
        },
        "text_6VJUJG": {
          "type": "text",
          "settings": {
            "text": "<p><br/>Verschenke einzigartigen Genuss mit unseren exquisiten <a href=\"/collections/gewurz\" title=\"Alle Gewürze\"><em><strong>Gewürzen</strong></em></a>! Unsere hochwertigen Gewürzmischungen sind das perfekte Geschenk für alle Feinschmecker - das ganze Jahr über. <br/><br/></p><p>Stelle aus unserer Vielfalt eine <a href=\"/collections/alle-geschenke\" title=\"Alle Geschenke\"><em><strong>Geschenkbox </strong></em></a>zusammen, die genau auf den Geschmack des Beschenkten abgestimmt ist. Egal ob für besondere Anlässe oder als kleine Überraschung - unsere attraktiven Banderolen und variierenden Boxengrößen machen jedes Geschenk zu einem echten Hingucker. </p><p><br/>Du bist noch unentschlossen? Mit unseren <a href=\"/products/stay-spicesd-gutschein\" title=\"STAY Spiced ! Gutschein\"><em><strong>Gutscheinen </strong></em></a>schenkst du Freude und Flexibilität zugleich. </p>",
            "content_source": "custom",
            "text_size": "regular"
          }
        },
        "button_6QMWD6": {
          "type": "button",
          "settings": {
            "button_label": "Entdecke hier deine Geschenkideen",
            "link": "",
            "target_id": "",
            "open_in_new_window": false,
            "button_size": "regular",
            "button_style": "outline"
          }
        }
      },
      "block_order": [
        "title_iHgacR",
        "subtitle_nXD67p",
        "text_6VJUJG",
        "button_6QMWD6"
      ],
      "settings": {
