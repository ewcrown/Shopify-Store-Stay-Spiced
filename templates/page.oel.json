    "rich_text_DFxDtz": {
      "type": "rich-text",
      "blocks": {
        "title_peRpDB": {
          "type": "title",
          "settings": {
            "title": "Vom Feld bis zur Flasche",
            "title_size": "h3",
            "seo_h_tag": "h2"
          }
        },
        "subtitle_Rr68Tc": {
          "type": "subtitle",
          "settings": {
            "subtitle": "Unser Kürbiskernöl wird in Handarbeit und mit großer Sorgfalt hergestellt",
            "title_size": "h2"
          }
        },
        "text_hKcaXy": {
          "type": "text",
          "settings": {
            "text": "<ul><li><strong>Anbau</strong>: Die Kürbisse stammen aus unserem eigenen Anbau und wachsen auf fruchtbarem Innviertler Boden. Die goldgelben Früchte werden im Herbst direkt am Feld entkernt, das Fruchtfleisch bleibt als natürlicher Dünger zurück.</li><li><strong>Trocknung</strong>: Die Kerne werden mit Wasser gereinigt und unter warmer Luft schonend getrocknet.</li><li><strong>Pressung</strong>: Vor dem Pressen werden die Kerne nochmals gereinigt und in einer Steinmühle zu Brei verarbeitet. Dieser wird mit Wasser und Salz vermengt und unter Rühren sanft geröstet – traditionell über Holzfeuer.</li><li><strong>Pressvorgang</strong>: Das geröstete Kürbismehl wird im warmen Zustand in Schichten gepresst. Das dabei gewonnene Öl ruht mehrere Tage in Kannen, um Geschmack und Klarheit zu entfalten – ganz ohne Filtration oder Raffination.</li><li><strong>Verwertung</strong>: Der verbleibende Kürbiskuchen wird als hochwertiges Futtermittel weiterverwendet – für eine ressourcenschonende Produktion.<br/>Für einen Liter Öl werden rund 2,5 kg Kürbiskerne benötigt – das Ergebnis ist ein naturreines Produkt aus 100 % Innviertler Landwirtschaft.<br/></li></ul>",
            "content_source": "custom",
            "text_size": "regular"
          }
        },
        "button_RkMHAb": {
          "type": "button",
          "settings": {
            "button_label": "Mehr Eigenanbau",
