            "subtitle": "Die Anfänge",
            "title_size": "h2"
          }
        },
        "title_46nghM": {
          "type": "title",
          "settings": {
            "title": "<strong>Vom Lehrling zum Visionär</strong>",
            "title_size": "h2",
            "seo_h_tag": "h2"
