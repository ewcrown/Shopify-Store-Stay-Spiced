    "rich_text_tPPrXT": {
      "type": "rich-text",
      "blocks": {
        "title_XGgQcM": {
          "type": "title",
          "settings": {
            "title": "Gastgeschenke für die Hochzeit – Dankesagen mit Geschmack",
            "title_size": "h2",
            "seo_h_tag": "h2"
          }
        },
        "text_YCqRjH": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Macht eure Hochzeit unvergesslich – nicht nur für euch, sondern auch für eure Gäste.</strong><br/><br/>Unsere personalisierten Gewürzdosen sind das perfekte Gastgeschenk, um eure Liebe und Wertschätzung auf geschmackvolle Weise auszudrücken.</p><p>Jede Dose wird individuell für euch gestaltet und trägt eure Namen sowie das Hochzeitsdatum – ein einzigartiges Andenken an euren großen Tag.</p><p>Im Inneren jeder Dose habt <strong>ihr</strong> die Wahl für eure Gäste: <strong>Amore, Schwarzes Gold, Alpenkräuter-Gewürzsalz</strong> oder <strong>Chilisalz</strong>.</p><p>Ob als liebevolles Dankeschön oder kleine Überraschung am Tisch – die stilvollen Gewürzdosen bringen Freude und Geschmack in die Küchen eurer Liebsten.</p>",
            "content_source": "custom",
            "text_size": "regular"
          }
        }
