            "seo_h_tag": "h2"
          }
        },
        "text_DUMMyr": {
          "type": "text",
          "settings": {
            "text": "<p>Du suchst das perfekte Hochzeitsgeschenk? Die Liebe ist wie ein Gewürz – sie macht alles ein bisschen süßer und auf jeden Fall unvergesslich.</p>",
            "content_source": "custom",
