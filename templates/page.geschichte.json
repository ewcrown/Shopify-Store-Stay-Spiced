        "text_zDKpxc": {
          "type": "text",
          "settings": {
            "text": "<p><em>„Die perfekten Gewürze wachsen an den am besten geeigneten Orten. Deshalb arbeiten wir eng mit unseren Bauern zusammen, um immer jene Gewürzqualität zu ernten, die keine keine Wünsche offen lässt.“</em></p>",
            "content_source": "custom",
            "text_size": "regular"
          }
        },
        "subtitle_ay9TyH": {
          "type": "subtitle",
          "settings": {
            "subtitle": "Martin Reich-Reiter",
            "title_size": "h2"
          }
        }
      },
      "block_order": [
        "text_zDKpxc",
