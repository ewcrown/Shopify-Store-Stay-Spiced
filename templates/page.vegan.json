    "rich_text_FAE7dh": {
      "type": "rich-text",
      "blocks": {
        "title_6XbxV3": {
          "type": "title",
          "settings": {
            "title": "Gewürze in der Veganen Küche",
            "title_size": "h2",
            "seo_h_tag": "h2"
          }
        },
        "text_JyR9Am": {
          "type": "text",
          "settings": {
            "text": "<p><br/><strong>Gewürze</strong> spielen in der veganen Küche eine zentrale Rolle, da sie Geschmack, Vielfalt und ernährungsphysiologische Vorteile vereinen. </p><p><strong>Viele Gewürze enthalten bioaktive Pflanzenstoffe</strong> wie Polyphenole, Flavonoide oder ätherische Öle, die antioxidative, entzündungshemmende oder antimikrobielle Eigenschaften aufweisen. </p><p>Kurkuma etwa wird aufgrund des Wirkstoffs Curcumin intensiv erforscht, ebenso wie Kreuzkümmel, Ingwer oder Zimt. Neben ihrem gesundheitlichen Potenzial tragen Gewürze wesentlich dazu bei, den natürlichen Eigengeschmack pflanzlicher Zutaten zu unterstreichen und Gerichte geschmacklich zu veredeln – ohne den Einsatz von Zusatzstoffen oder übermäßigem Salz. </p><p>Sie machen die vegane Küche nicht nur aromatisch, sondern auch funktional wertvoll.<br/><br/><br/></p>",
            "content_source": "custom",
            "text_size": "regular"
          }
        }
      },
      "block_order": [
        "title_6XbxV3",
        "text_JyR9Am"
      ],
      "name": "t:sections.rich-text.name",
      "settings": {
        "element_id": "",
        "image": "shopify://shop_images/3_6e8b223f-7ee8-420f-9f5e-4fbb41208771.png",
        "image_position": "left",
